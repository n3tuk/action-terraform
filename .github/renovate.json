{
  "extends": ["config:recommended"],
  "timezone": "Europe/London",
  "enabledManagers": ["pre-commit", "github-actions", "dockerfile"],
  "draftPR": true,
  "labels": ["type/dependencies", "release/chore"],
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "prCreation": "not-pending",
  "internalChecksFilter": "strict",
  "dependencyDashboard": true,
  "vulnerabilityAlerts": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchManagers": ["pre-commit"],
      "schedule": ["* 18 * * *"],
      "commitMessagePrefix": "chore(pre-commit): ",
      "commitMessageAction": "bump",
      "labels": ["type/dependencies", "release/skip"]
    },
    {
      "matchManagers": ["github-actions"],
      "schedule": ["* 19 * * *"],
      "commitMessagePrefix": "chore(actions): ",
      "commitMessageAction": "bump"
    },
    {
      "matchManagers": ["dockerfile"],
      "schedule": ["* 20 * * *"],
      "commitMessagePrefix": "chore(dockerfile): ",
      "commitMessageAction": "bump"
    },
    {
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["n3tuk/*"],
      "minimumReleaseAge": null,
      "prCreation": "immediate"
    },
    {
      "matchManagers": ["pre-commit"],
      "matchPackageNames": ["pre-commit/mirrors-prettier"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ]
}
